# Copy to .env and fill in values
DJANGO_SECRET_KEY=replace-with-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Docker Compose:  DATABASE_URL=postgres://digivault:password@db:5432/digivault
# Local (no Docker): DATABASE_URL=postgres://digivault:password@localhost:5432/digivault
DATABASE_URL=postgres://digivault:password@db:5432/digivault

# Snippet CDN URL (where s.js is hosted)
SNIPPET_CDN_URL=https://cdn.digivault.digilatics.co

# Redis
# Docker Compose:  REDIS_URL=redis://redis:6379/0
# Local (no Docker): REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# Vault encryption key — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=replace-with-fernet-key
# For key rotation, use an ordered, comma-separated list instead (first key
# encrypts new data; all keys decrypt). See docs/runbooks/key-rotation.md.
# VAULT_ENCRYPTION_KEYS=new-primary-key,previous-key

# Email (development uses console backend)
# Production SMTP example: smtp+tls://user:password@smtp.hostinger.com:587
EMAIL_URL=console://
DEFAULT_FROM_EMAIL=Digivault <noreply@digivault.digilatics.co>

# Frontend URL (used in invitation emails etc.)
FRONTEND_URL=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ClickUp integration — get from ClickUp → Settings → Apps → API Token
CLICKUP_API_TOKEN=

# Observability (all optional)
# Sentry error tracking — leave blank to disable
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
LOG_LEVEL=INFO
# Dead-man's-switch: a healthchecks.io / cronitor heartbeat URL, pinged every 5 min
HEARTBEAT_PING_URL=

# Sentry (production only)
SENTRY_DSN=

# ── Uptime monitoring ────────────────────────────────────────────────────────
# All checks leave from this server's single public IP, so the monitor's job is
# to behave well enough not to get that IP blocked.

# The IPs clients should allowlist, published at GET /api/monitoring-info/ and
# rendered on the public /bot page our User-Agent points at. SET THIS IN
# PRODUCTION — left blank, the allowlist instructions cannot name an IP and the
# page is useless. Comma-separated.
MONITOR_EGRESS_IPS=

# Monitors dispatched per 30s beat tick. Spreads the fleet across the interval
# instead of bursting, which is what looks like a scanner sweep.
MONITOR_MAX_CHECKS_PER_TICK=8

# A failing request is re-checked this many times, with these gaps in seconds,
# before it counts as an outage. Three requests, one data point.
MONITOR_CONFIRM_ATTEMPTS=3
MONITOR_CONFIRM_DELAYS=15,45

# Before a confirmed failure becomes an alert, the monitor checks whether real
# visitors were being served (website.last_seen_at, bumped on every ingest).
# Recent traffic means we are blocked, not the site down. Capped so a
# permanently blocked monitor cannot go permanently silent.
LIVENESS_WINDOW_SECONDS=600
LIVENESS_MAX_SUPPRESSED_CHECKS=6

# Per-host budget for every server-side fetch of a customer origin, keyed on the
# registrable domain. The uptime monitor bypasses it (its own interval is far
# gentler); the burst callers — SEO checker, scan, snippet verify — do not.
OUTBOUND_MIN_INTERVAL_SECONDS=20
OUTBOUND_MAX_PER_HOUR=60
