# Production environment — copy to .env.production and fill in all values
# NEVER commit .env.production to git

# Django
DJANGO_SECRET_KEY=replace-with-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=digivault.digilatics.co

# Database — password must match DB_PASSWORD below
DATABASE_URL=postgres://digivault:REPLACE_DB_PASSWORD@db:5432/digivault
DB_PASSWORD=REPLACE_DB_PASSWORD

# Redis
REDIS_URL=redis://redis:6379/0

# Vault encryption key — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=replace-with-fernet-key

# Email — MUST be a real SMTP URL in production, or invitation / password-reset
# / set-password emails are silently discarded and new members cannot log in.
# Brevo SMTP relay (login + SMTP key from Brevo → SMTP & API → SMTP; the SMTP
# key is NOT your Brevo account password; @ in the login is encoded as %40):
#   EMAIL_URL=smtp+tls://LOGIN%40smtp-brevo.com:SMTP_KEY@smtp-relay.brevo.com:587
# consolemail:// only logs emails to stdout — for local testing ONLY, never prod.
EMAIL_URL=smtp+tls://REPLACE_LOGIN%40smtp-brevo.com:REPLACE_SMTP_KEY@smtp-relay.brevo.com:587
# From address must be on a domain authenticated in Brevo (DKIM/DMARC).
DEFAULT_FROM_EMAIL=Digivault <noreply@digilatics.co>

# Frontend URL (used in invitation/reset-password emails)
FRONTEND_URL=https://digivault.digilatics.co

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS — must match the public domain
CORS_ALLOWED_ORIGINS=https://digivault.digilatics.co

# Snippet CDN URL
SNIPPET_CDN_URL=https://cdn.digivault.digilatics.co

# Next.js (also set as build ARG in docker-compose.production.yml)
NEXT_PUBLIC_API_URL=https://digivault.digilatics.co
NODE_ENV=production

# Sentry (optional)
SENTRY_DSN=
