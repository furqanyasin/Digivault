# Production environment — copy to .env.production and fill in all values
# NEVER commit .env.production to git

# Django
DJANGO_SECRET_KEY=replace-with-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=digivault.digilatics.co

# Database — password must match DB_PASSWORD below
DATABASE_URL=postgres://digivault:REPLACE_DB_PASSWORD@db:5432/digivault
DB_PASSWORD=REPLACE_DB_PASSWORD

# Redis
REDIS_URL=redis://redis:6379/0

# Vault encryption key — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=replace-with-fernet-key

# Email — MUST be a real SMTP URL in production, or invitation / password-reset
# / set-password emails are silently discarded and new members cannot log in.
# Brevo SMTP relay (login + SMTP key from Brevo → SMTP & API → SMTP; the SMTP
# key is NOT your Brevo account password; @ in the login is encoded as %40):
#   EMAIL_URL=smtp+tls://LOGIN%40smtp-brevo.com:SMTP_KEY@smtp-relay.brevo.com:587
# consolemail:// only logs emails to stdout — for local testing ONLY, never prod.
EMAIL_URL=smtp+tls://REPLACE_LOGIN%40smtp-brevo.com:REPLACE_SMTP_KEY@smtp-relay.brevo.com:587
# From address must be on a domain authenticated in Brevo (DKIM/DMARC).
DEFAULT_FROM_EMAIL=Digivault <noreply@digilatics.co>

# Frontend URL (used in invitation/reset-password emails)
FRONTEND_URL=https://digivault.digilatics.co

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS — must match the public domain
CORS_ALLOWED_ORIGINS=https://digivault.digilatics.co

# Where the tracking snippet is served from. The /api suffix is required —
# nginx proxies only /api/... to Django, and cdn.digivault.digilatics.co has no
# DNS record.
SNIPPET_CDN_URL=https://digivault.digilatics.co/api

# WordPress vulnerability data (wpscan.com). Optional, but without it the
# security scan reports a hardcoded risky-plugin list instead of real CVEs —
# and those findings feed the site health score.
WPSCAN_API_KEY=

# Next.js (also set as build ARG in docker-compose.production.yml)
NEXT_PUBLIC_API_URL=https://digivault.digilatics.co
NODE_ENV=production

# Sentry (optional). Traces sample 5% of requests and tasks by default.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Self-monitoring (docs/runbooks/backups.md). Strongly recommended: without
# them nothing outside this server notices when Digivault itself stops.
# Heartbeat: a healthchecks.io URL pinged every 5 min, withheld while any uptime
# monitor is more than 5 min overdue (HEARTBEAT_MONITOR_GRACE_SECONDS).
HEARTBEAT_PING_URL=
# Nightly ./backup-db.sh (host cron). The remote is an rclone target; without
# it the dump never leaves this server. BACKUP_PING_URL is pinged only when a
# verified dump reached the remote.
BACKUP_RCLONE_REMOTE=
BACKUP_PING_URL=
# Heartbeat is also withheld while a Celery queue is backed up past its limit.
# Semicolon-separated (django-environ splits typed dicts on ';').
# HEARTBEAT_QUEUE_LIMITS=ingest=5000;monitors=200;slow=500;celery=1000

# Batched ingest, per site (empty = off for every site; * = all). Turn a site on
# only when its ingest_lock log lines show contention:
# docs/runbooks/capacity-checks.md.
# INGEST_BATCH_SITES=

# NOTE: worker counts and the trusted-proxy list are read by *compose*, so they
# go in the deploy shell or `.env`, not here (this file only reaches the
# containers): UVICORN_WORKERS (api, 4), UVICORN_INGEST_WORKERS (api-ingest, 2),
# FORWARDED_ALLOW_IPS (private ranges; never '*'). DB_POOL is set per service
# in the compose file. See docs/runbooks/ingest-pool.md.
